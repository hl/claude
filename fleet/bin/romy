#!/bin/sh
set -eu

# Romy — the claude-side fleet console. Launches the top-level session that
# dispatches one Michele per task into herdr panes.
#
# Deliberately separate from ~/.codex/fleet/bin/romy, which launches the codex
# implementation of the same role. The two stacks read different role files and
# spawn different workers; don't cross them.

if [ "${HERDR_ENV:-}" != "1" ]; then
  printf '%s\n' "Romy must be launched inside a Herdr-managed pane (HERDR_ENV=1)." >&2
  exit 1
fi

for command_name in herdr claude; do
  command -v "$command_name" >/dev/null 2>&1 || {
    printf '%s\n' "Romy requires $command_name on PATH." >&2
    exit 1
  }
done

projects_root=${ROMY_PROJECTS_ROOT:-"$HOME/Projects"}
[ -d "$projects_root" ] || {
  printf '%s\n' "Projects root does not exist: $projects_root (set ROMY_PROJECTS_ROOT)" >&2
  exit 1
}
cd "$projects_root"

# Model and reasoning effort come from the agent's frontmatter — never pass --model.
exec claude \
  --agent romy \
  --dangerously-skip-permissions \
  "$@"
